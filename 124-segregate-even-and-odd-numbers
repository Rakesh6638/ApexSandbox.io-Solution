public static void segregateEvenOdd(List<Integer> numbers){
    //code here
    List<Integer> evenNums = new List<Integer>();
    List<Integer> oddNums = new List<Integer>();
    for(Integer val : numbers){
        if(Math.mod(val,2)==0){
            evenNums.add(val);
        }
        else{
            oddNums.add(val);
        }
    }
    evenNums.addAll(oddNums);
    return evenNums;
}