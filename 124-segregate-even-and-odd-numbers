public static void segregateEvenOdd(List<Integer> numbers){
    //code here
    if(numbers == null || numbers.isEmpty()){
        return;
    }
    
    Integer left = 0;
    Integer right = numbers.size()-1;

    for(Integer i : numbers){
        if(Math.mod(i,2)==0 && left < right){
            left++;
        }
        else if(Math.mod(i,2)!=0 && left < right){
            right--;
        }

        // If left is still less than right, swap the odd and even numbers
        if (left < right) {
            Integer temp = numbers[left];
            numbers.add(left, numbers[right]);
            numbers.add(right, temp);
            
            left++;
            right--;
        }
    }
}