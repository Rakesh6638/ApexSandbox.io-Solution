public static void segregateEvenOdd(List<Integer> numbers){
    //code here
    List<Integer> result =new List<Integer>();
    Integer firstNum = numbers[0];

    for(Integer i : numbers){

        if(Math.mod(i,2)==0){
            result.add(0,i);
        }
        else{
            result.add(i);
        }
    }
}