public Boolean isPalindrome(String str){
    //code here

    if(String.isBlank(str)){
        return false;
    }

    Integer left=0;
    Integer right=str.length()-1;

    str = str.replaceAll('[^0-9a-zA-Z]','');
    
    while(left<right){
        if(str.substring(left, left+1) != str.substring(right-1, right)){
            return false;
        }
        left++;
        right--;
    }
    return true;
}