public Boolean isPrime(Integer num) {
    //code here
    if(num <= 1) return false;
    if(num == 2) return true;
    if(Math.mod(num,2) == 0) return false;

    Integer limit = (Integer)Math.sqrt(num);
    for(Integer i=3; i<limit; i++){
        if(Math.mod(num,i)==0){
            return false;
        }
    }
    return true;
}