public void defragging(Integer[] memory)
{
    // code here
    Integer left = 0;

    for (Integer i = 0; i < memory.size(); i++) {
        if (memory[i] != -1) {
            if (i != left) {
                Integer temp = memory[left];
                memory[left] = memory[i];
                memory[i] = temp;
            }
            left++;
        }
    }
}