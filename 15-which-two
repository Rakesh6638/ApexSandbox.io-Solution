public String whichTwo(Integer a, Integer b, Integer c) {
    //code here
    if(a > b){
        if(a > c && (b+c == a)){
            return 'a';
        }
        else if(a<c && (a+b == c)){
            return 'c';
        }
    }
    else if(b > c && (a+c == b)){
            return 'b';
    }
    else if(b < c && (a+b == c)){
            return 'c';
    }
    return '';
}